@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ssh: <https://kg.odissei.nl/odissei/odissei-kg/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix coda: <https://terms.codata.org/rdmt/> .
@prefix schema: <https://schema.org/> .

schema:SoftwareSourceCode rdf:type owl:Class ;
    rdfs:label "Software Source Code" ;
    rdfs:subClassOf coda:research-software.

bibo:AcademicArticle rdf:type owl:Class ;
    rdfs:label "Academic Article" ;
    rdfs:subClassOf coda:data-paper .

coda:data-paper rdf:type owl:Class ;
    rdfs:label "Research Paper" .

ssh:hasDOI rdf:type owl:ObjectProperty ;
    rdfs:label "has DOI" ;
    rdfs:domain rdfs:Resource ;
    rdfs:range bibo:DOI .

ssh:usesDataset rdf:type owl:ObjectProperty ;
    rdfs:label "uses dataset" ;
    rdfs:domain schema:SoftwareSourceCode ;
    rdfs:range coda:Dataset .

ssh:producedByAcademicArticle rdf:type owl:ObjectProperty ;
    rdfs:label "produced by academic article" ;
    rdfs:domain schema:SoftwareSourceCode ;
    rdfs:range bibo:AcademicArticle .

ssh:hasAuthor rdf:type owl:ObjectProperty ;
    rdfs:label "has author" ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range schema:Author .

ssh:representedByORCID rdf:type owl:ObjectProperty ;
    rdfs:label "represented by ORCID" ;
    rdfs:domain schema:Author ;
    rdfs:range coda:orcid .

ssh:producedByProject rdf:type owl:ObjectProperty ;
    rdfs:label "produced by project" ;
    rdfs:domain bibo:AcademicArticle ;
    rdfs:range schema:ResearchProject .

ssh:writesResearchPaper rdf:type owl:ObjectProperty ;
    rdfs:label "writes research paper" ;
    rdfs:domain schema:Author ;
    rdfs:range coda:data-paper .

ssh:hasORCID rdf:type owl:ObjectProperty ;
    rdfs:label "has ORCID" ;
    rdfs:domain schema:Author ;
    rdfs:range coda:orcid .
