@prefix dsv: <https://w3id.org/dsv-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix coda: <https://terms.codata.org/rdmt/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Object Properties
#################################################################

###  http://purl.org/ontology/bibo/authorList
bibo:authorList rdf:type owl:ObjectProperty ;
                rdfs:domain bibo:AcademicArticle ;
                rdfs:range schema:Author ;
                rdfs:label "has author" .


###  http://purl.org/ontology/bibo/cites
bibo:cites rdf:type owl:ObjectProperty ;
           rdfs:domain schema:Author ,
                       schema:SoftwareSourceCode ;
           rdfs:range bibo:AcademicArticle ,
                      coda:data-paper ;
           rdfs:label "produced by academic article" ,
                      "writes research paper" .


###  http://purl.org/ontology/bibo/doi
bibo:doi rdf:type owl:ObjectProperty ;
         rdfs:domain coda:data-paper ;
         rdfs:range bibo:DOI ;
         rdfs:label "has DOI" .


###  http://purl.org/ontology/bibo/producer
bibo:producer rdf:type owl:ObjectProperty ;
              rdfs:domain bibo:AcademicArticle ;
              rdfs:range schema:ResearchProject ;
              rdfs:label "produced by project" .


###  http://xmlns.com/foaf/0.1/Agent
foaf:Agent rdf:type owl:ObjectProperty ;
           rdfs:domain schema:Author ;
           rdfs:range coda:orcid ;
           rdfs:label "has ORCID" ,
                      "represented by ORCID" .


###  https://w3id.org/dsv-ontology#datasetSchema
dsv:datasetSchema rdf:type owl:ObjectProperty ;
                  rdfs:domain schema:SoftwareSourceCode ;
                  rdfs:range coda:Dataset ;
                  rdfs:label "uses dataset" .


#################################################################
#    Classes
#################################################################

###  http://purl.org/ontology/bibo/AcademicArticle
bibo:AcademicArticle rdf:type owl:Class ;
                     rdfs:subClassOf coda:data-paper ;
                     rdfs:label "Academic Article" .


###  http://purl.org/ontology/bibo/DOI
bibo:DOI rdf:type owl:Class .


###  https://schema.org/Author
schema:Author rdf:type owl:Class .


###  https://schema.org/ResearchProject
schema:ResearchProject rdf:type owl:Class .


###  https://schema.org/SoftwareSourceCode
schema:SoftwareSourceCode rdf:type owl:Class ;
                          rdfs:subClassOf coda:research-software ;
                          rdfs:label "Software Source Code" .


###  https://terms.codata.org/rdmt/Dataset
coda:Dataset rdf:type owl:Class .


###  https://terms.codata.org/rdmt/data-paper
coda:data-paper rdf:type owl:Class ;
                rdfs:label "Research Paper" .


###  https://terms.codata.org/rdmt/orcid
coda:orcid rdf:type owl:Class .


###  https://terms.codata.org/rdmt/research-software
coda:research-software rdf:type owl:Class .


