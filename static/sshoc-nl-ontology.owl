<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:dsv-ontology="https://w3id.org/dsv-ontology#"
    xmlns:cube="http://purl.org/linked-data/cube#"
    xmlns:csvw="http://www.w3.org/ns/csvw#"
    xmlns:bibo="http://purl.org/ontology/bibo/"
    xmlns:event="http://purl.org/NET/c4dm/event.owl#"
    xmlns:foaf="http://xmlns.com/foaf/0.1/"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:vann="http://purl.org/vocab/vann/"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:schema="https://schema.org/"
    xmlns:rdmt="https://terms.codata.org/rdmt/">

  <owl:Ontology rdf:about="https://w3id.org/dsv-ontology">
    <owl:imports rdf:resource="http://purl.org/linked-data/cube"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/csvw"/>
    <owl:imports rdf:resource="http://purl.org/ontology/bibo/"/>
    <owl:imports rdf:resource="http://purl.org/NET/c4dm/event.owl#"/>
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    <owl:imports rdf:resource="http://xmlns.com/foaf/0.1/"/>
    <vann:preferredNamespacePrefix>dsv-ontology</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/dsv-ontology#</vann:preferredNamespaceUri>
  </owl:Ontology>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#CategoricalDataType">
    <rdfs:label xml:lang="en">Categorical Statistical Data Type</rdfs:label>
    <rdfs:comment xml:lang="en">Set of statistical data types can be observed and - or - categorised.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dsv-ontology#StatisticalDataType"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#Column">
    <rdfs:label xml:lang="en">Dataset Component</rdfs:label>
    <rdfs:comment xml:lang="en">Set of individual columns of a dataset.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/linked-data/cube#ComponentSpecification"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/csvw#Column"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#ColumnProperty">
    <rdfs:label xml:lang="en">Column Property</rdfs:label>
    <rdfs:comment xml:lang="en">RDF Properties represented by the column.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/linked-data/cube#DimensionProperty"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#Dataset">
    <rdfs:label xml:lang="en">Dataset</rdfs:label>
    <rdfs:comment xml:lang="en">Set of data.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/linked-data/cube#DataSet"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/csvw#Table"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#DatasetSchema">
    <rdfs:label xml:lang="en">Dataset Schema</rdfs:label>
    <rdfs:comment xml:lang="en">The structural schema of a dataset.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/linked-data/cube#DataStructureDefinition"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/csvw#TableSchema"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#StatisticalDataType">
    <rdfs:label xml:lang="en">Statistical Data Type</rdfs:label>
    <rdfs:comment xml:lang="en">Set of statistical data types.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#SummaryStatistics">
    <rdfs:label xml:lang="en">Summary Statistics</rdfs:label>
    <rdfs:comment xml:lang="en">Set of summary statistics about the dataset or column.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#NumericalDataType">
    <rdfs:label xml:lang="en">Numerical Statistical Data Type</rdfs:label>
    <rdfs:comment xml:lang="en">Set of statistical data types can be measured and quantified.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dsv-ontology#StatisticalDataType"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#IntervalDataType">
    <rdfs:label xml:lang="en">Interval Statistical Data Type</rdfs:label>
    <rdfs:comment xml:lang="en">Statistical data type representing ordered data measured over a numerical scale with equal distance between units.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dsv-ontology#NumericalDataType"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#NominalDataType">
    <rdfs:label xml:lang="en">Nominal Statistical Data Type</rdfs:label>
    <rdfs:comment xml:lang="en">Statistical data type representing discrete units that cannot be ordered or measured.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dsv-ontology#CategoricalDataType"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#OrdinalDataType">
    <rdfs:label xml:lang="en">Ordinal Statistical Data Type</rdfs:label>
    <rdfs:comment xml:lang="en">Statistical data type representing discrete units that can be ordered or measured.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dsv-ontology#CategoricalDataType"/>
  </owl:Class>

  <owl:Class rdf:about="https://w3id.org/dsv-ontology#RatioDataType">
    <rdfs:label xml:lang="en">Ratio Statistical Data Type</rdfs:label>
    <rdfs:comment xml:lang="en">Statistical data type representing ordered data with equal distance between units, where negative values are not allowed.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dsv-ontology#NumericalDataType"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/AcademicArticle">
    <rdfs:label xml:lang="en">Academic Article</rdfs:label>
    <rdfs:comment xml:lang="en">A scholarly academic article, typically published in a journal.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://terms.codata.org/rdmt/data-paper"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Article"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Article">
    <rdfs:label xml:lang="en">Article</rdfs:label>
    <rdfs:comment xml:lang="en">A written composition in prose, usually nonfiction, on a specific topic, forming an independent part of a book or other publication, as a newspaper or magazine.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/AudioVisualDocument">
    <rdfs:label xml:lang="en">audio-visual document</rdfs:label>
    <rdfs:comment xml:lang="en">An audio-visual document; film, video, and so forth.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Book">
    <rdfs:label xml:lang="en">Book</rdfs:label>
    <rdfs:comment xml:lang="en">A written or printed work of fiction or nonfiction, usually on sheets of paper fastened or bound together within covers.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/BookSection">
    <rdfs:label xml:lang="en">Book Section</rdfs:label>
    <rdfs:comment xml:lang="en">A section of a book.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/DocumentPart"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/CollectedDocument">
    <rdfs:label xml:lang="en">Collected Document</rdfs:label>
    <rdfs:comment xml:lang="en">A document that simultaneously contains other documents.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
    <rdfs:subClassOf rdf:resource="https://kg.odissei.nl/.well-known/genid/5f487fed82cd9039c3905ee2142c0b7b"/>
    <rdfs:subClassOf rdf:resource="https://kg.odissei.nl/.well-known/genid/79e99055d875c8d7f1971eb856094886"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Collection">
    <rdfs:label xml:lang="en">Collection</rdfs:label>
    <rdfs:comment xml:lang="en">A collection of Documents or Collections</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://kg.odissei.nl/.well-known/genid/68de51b157f3af78b55e085ca7ab906d"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/DocumentPart">
    <rdfs:label xml:lang="en">document part</rdfs:label>
    <rdfs:comment xml:lang="en">a distinct part of a larger document or collected document.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
    <rdfs:subClassOf rdf:resource="https://kg.odissei.nl/.well-known/genid/f4e35d90090f6cd06b239bbf60f3fbd4"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Excerpt">
    <rdfs:label xml:lang="en">Excerpt</rdfs:label>
    <rdfs:comment xml:lang="en">A passage selected from a larger work.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/DocumentPart"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Image">
    <rdfs:label xml:lang="en">Image</rdfs:label>
    <rdfs:comment xml:lang="en">A document that presents visual or diagrammatic information.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Issue">
    <rdfs:label xml:lang="en">Issue</rdfs:label>
    <rdfs:comment xml:lang="en">something that is printed or published and distributed, esp. a given number of a periodical</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/CollectedDocument"/>
    <rdfs:subClassOf rdf:resource="https://kg.odissei.nl/.well-known/genid/e513e5068ecb92f8d6d1386e3cd25181"/>
    <rdfs:subClassOf rdf:resource="https://kg.odissei.nl/.well-known/genid/f79477d37db71e256beb2d5c250077bd"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/LegalCaseDocument">
    <rdfs:label xml:lang="en">Legal Case Document</rdfs:label>
    <rdfs:comment xml:lang="en">A document accompanying a legal case.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/LegalDocument"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/LegalDecision">
    <rdfs:label xml:lang="en">Decision</rdfs:label>
    <rdfs:comment xml:lang="en">A document containing an authoritative determination (as a decree or judgment) made after consideration of facts or law.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/LegalCaseDocument"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/LegalDocument">
    <rdfs:label xml:lang="en">Legal Document</rdfs:label>
    <rdfs:comment xml:lang="en">A legal document; for example, a court decision, a brief, and so forth.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Legislation">
    <rdfs:label xml:lang="en">Legislation</rdfs:label>
    <rdfs:comment xml:lang="en">A legal document proposing or enacting a law or a group of laws.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/LegalDocument"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Note">
    <rdfs:label xml:lang="en">Note</rdfs:label>
    <rdfs:comment xml:lang="en">Notes or annotations about a resource.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Performance">
    <rdfs:label xml:lang="en">Performance</rdfs:label>
    <rdfs:comment xml:lang="en">A public performance.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/NET/c4dm/event.owl#Event"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Periodical">
    <rdfs:label xml:lang="en">Periodical</rdfs:label>
    <rdfs:comment xml:lang="en">A group of related documents issued at regular intervals.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Collection"/>
    <rdfs:subClassOf rdf:resource="https://kg.odissei.nl/.well-known/genid/1115573aad1e9e5045f117b76bb63b67"/>
    <rdfs:subClassOf rdf:resource="https://kg.odissei.nl/.well-known/genid/fcc0f7551e4ea9e43bb974b8eca261a6"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/PersonalCommunicationDocument">
    <rdfs:label xml:lang="en">Personal Communication Document</rdfs:label>
    <rdfs:comment xml:lang="en">A personal communication manifested in some document.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Slide">
    <rdfs:label xml:lang="en">Slide</rdfs:label>
    <rdfs:comment xml:lang="en">A slide in a slideshow</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/DocumentPart"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Specification">
    <rdfs:label xml:lang="en">Specification</rdfs:label>
    <rdfs:comment xml:lang="en">A document describing a specification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Thesis">
    <rdfs:label xml:lang="en">Thesis</rdfs:label>
    <rdfs:comment xml:lang="en">A document created to summarize research findings associated with the completion of an academic degree.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Webpage">
    <rdfs:label xml:lang="en">Webpage</rdfs:label>
    <rdfs:comment xml:lang="en">A web page is an online document available (at least initially) on the world wide web. A web page is written first and foremost to appear on the web, as distinct from other online resources such as books, manuscripts or audio documents which use the web primarily as a distribution mechanism alongside other more traditional methods such as print.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/AudioDocument">
    <rdfs:label xml:lang="en">audio document</rdfs:label>
    <rdfs:comment xml:lang="en">An audio document; aka record.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Bill">
    <rdfs:label xml:lang="en">Bill</rdfs:label>
    <rdfs:comment xml:lang="en">Draft legislation presented for discussion to a legal body.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Legislation"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Brief">
    <rdfs:label xml:lang="en">Brief</rdfs:label>
    <rdfs:comment xml:lang="en">A written argument submitted to a court.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/LegalCaseDocument"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Chapter">
    <rdfs:label xml:lang="en">Chapter</rdfs:label>
    <rdfs:comment xml:lang="en">A chapter of a book.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/BookSection"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Code">
    <rdfs:label xml:lang="en">Code</rdfs:label>
    <rdfs:comment xml:lang="en">A collection of statutes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Periodical"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/Conference">
    <rdfs:label xml:lang="en">Conference</rdfs:label>
    <rdfs:comment xml:lang="en">A meeting for consultation or discussion.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/NET/c4dm/event.owl#Event"/>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/ontology/bibo/CourtReporter">
    <rdfs:label xml:lang="en">Court Reporter</rdfs:label>
    <rdfs:comment xml:lang="en">A collection of legal cases.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Periodical"/>
  </owl:Class>

  <owl:ObjectProperty rdf:about="http://purl.org/ontology/bibo/cites">
    <rdfs:label xml:lang="en">cites</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a document to another document that is cited by the first document as reference, comment, review, quotation or for another purpose.</rdfs:comment>
    <rdfs:domain rdf:resource="https://schema.org/SoftwareSourceCode"/>
    <rdfs:range rdf:resource="http://purl.org/ontology/bibo/Document"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.org/ontology/bibo/affirmedBy">
    <rdfs:comment xml:lang="en">A legal decision that affirms a ruling.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/ontology/bibo/LegalDecision"/>
    <rdfs:range rdf:resource="http://purl.org/ontology/bibo/LegalDecision"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.org/ontology/bibo/reversedBy">
    <rdfs:comment xml:lang="en">A legal decision that reverses a ruling.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/ontology/bibo/LegalDecision"/>
    <rdfs:range rdf:resource="http://purl.org/ontology/bibo/LegalDecision"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/ontology/bibo/uri">
    <rdfs:label xml:lang="en">uri</rdfs:label>
    <rdfs:comment xml:lang="en">Universal Resource Identifier of a document</rdfs:comment>
    <rdfs:domain rdf:resource="https://kg.odissei.nl/.well-known/genid/f2f3e480a6852f58a44a3f662fd220f8"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </owl:DatatypeProperty>

  <owl:AnnotationProperty rdf:about="https://w3id.org/dsv-ontology#hasCategories">
    <rdfs:label xml:lang="en">has categories</rdfs:label>
    <rdfs:comment xml:lang="en">Links the dataset or column to a list of categories.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/dsv-ontology#Dataset"/>
    <rdfs:domain rdf:resource="https://w3id.org/dsv-ontology#Column"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
  </owl:AnnotationProperty>

  <owl:Class rdf:about="http://purl.org/linked-data/cube#ComponentSpecification"/>
  <owl:Class rdf:about="http://purl.org/linked-data/cube#DataSet"/>
  <owl:Class rdf:about="http://purl.org/linked-data/cube#DataStructureDefinition"/>
  <owl:Class rdf:about="http://purl.org/linked-data/cube#DimensionProperty"/>
  <owl:Class rdf:about="http://www.w3.org/2002/07/owl#DataProperty"/>
  <owl:Class rdf:about="http://www.w3.org/ns/csvw#Column"/>
  <owl:Class rdf:about="http://www.w3.org/ns/csvw#Table"/>
  <owl:Class rdf:about="http://www.w3.org/ns/csvw#TableSchema"/>
  <owl:Class rdf:about="http://purl.org/ontology/bibo/DOI"/>
  <owl:Class rdf:about="https://schema.org/SoftwareSourceCode"/>
  <owl:Class rdf:about="https://schema.org/ResearchProject"/>
  <owl:Class rdf:about="https://terms.codata.org/rdmt/Dataset"/>
  <owl:Class rdf:about="https://terms.codata.org/rdmt/orcid"/>
  <owl:Class rdf:about="https://terms.codata.org/rdmt/research-software"/>
  <owl:Class rdf:about="http://purl.org/NET/c4dm/event.owl#Event"/>
  <owl:Class rdf:about="http://purl.org/ontology/bibo/Event"/>
  <owl:ObjectProperty rdf:about="http://purl.org/ontology/bibo/producer">
    <rdfs:label xml:lang="en">producer</rdfs:label>
    <rdfs:comment xml:lang="en">Producer of a document or a collection of documents.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/ontology/bibo/AcademicArticle"/>
    <rdfs:domain rdf:resource="https://kg.odissei.nl/.well-known/genid/10e3426315eb8581f11c60b44e8c983d"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.org/ontology/bibo/contributorList">
    <rdfs:label xml:lang="en">list of contributors</rdfs:label>
    <rdfs:comment xml:lang="en">An ordered list of contributors. Normally, this list is seen as a priority list that order contributors by importance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/ontology/bibo/Document"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
  </owl:ObjectProperty>
</rdf:RDF>